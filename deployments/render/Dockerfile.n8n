# TILLU Engine - n8n Docker Image
FROM n8nio/n8n:latest

USER root

# Install additional packages needed for TILLU workflows
RUN apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    jq \
    tini

# Install Python dependencies for LangChain integration
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    langchain \
    langchain-groq \
    supabase \
    redis \
    httpx

# Create directory for TILLU workflows
RUN mkdir -p /home/node/.n8n/custom && chown -R node:node /home/node/.n8n

USER node

# Environment variables
ENV N8N_USER_FOLDER=/home/node/.n8n
ENV N8N_CONFIG_FILES=/home/node/.n8n/config
ENV WEBHOOK_URL=${WEBHOOK_URL}
ENV TILLU_GATEWAY_URL=${TILLU_GATEWAY_URL}

# Expose port
EXPOSE 5678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5678/healthz || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["n8n", "start"]
