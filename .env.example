# TILLU Backend Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# Redis/Upstash Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# =============================================================================
# LLM Provider API Keys
# =============================================================================
GROQ_API_KEY=grok-your-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=sk-or-v1-your-key
GOOGLE_API_KEY=your-google-api-key
COHERE_API_KEY=your-cohere-api-key
ANTHROPIC_API_KEY=sk-ant-your-api-key
OPENAI_API_KEY=sk-your-api-key
TOGETHER_API_KEY=your-together-api-key

# =============================================================================
# Hugging Face Configuration
# =============================================================================
HF_TOKEN=hf_your_token
HF_INFERENCE_API_URL=https://api-inference.huggingface.co
HF_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
HF_WHISPER_MODEL=openai/whisper-medium
HF_CLASSIFIER_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
HF_NER_MODEL=dbmdz/bert-large-cased-finetuned-conll03-english
HF_SUMMARIZER_MODEL=facebook/bart-large-cnn

# =============================================================================
# External API Keys (Free Tiers)
# =============================================================================
# News & Search
NEWSAPI_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-key
BRAVE_API_KEY=your-brave-key
GUARDIAN_API_KEY=your-guardian-key
NYT_API_KEY=your-nyt-key

# Financial
COINGECKO_API_KEY=your-coingecko-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
EXCHANGE_RATE_API_KEY=your-exchange-rate-key

# Weather & Environment
OPENWEATHERMAP_KEY=your-owm-key

# Google Services
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# Notion
NOTION_TOKEN=secret_your_token

# GitHub
GITHUB_TOKEN=ghp_your_token

# =============================================================================
# SearXNG Configuration
# =============================================================================
SEARXNG_URL=http://localhost:8080
SEARXNG_INTERNAL_URL=http://searxng:8080

# =============================================================================
# Playwright Scraper Service
# =============================================================================
PLAYWRIGHT_SERVICE_URL=http://localhost:3001
PLAYWRIGHT_INTERNAL_URL=http://playwright:3001

# =============================================================================
# Cloudflare Configuration
# =============================================================================
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# =============================================================================
# n8n Configuration
# =============================================================================
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook
N8N_API_KEY=n8n_api_your_key

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-for-jwt-signing
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
